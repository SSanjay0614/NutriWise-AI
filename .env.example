# ---- NutriWise backend secrets (copy to .env and fill in) ----
# From your Supabase project: Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Demo account seeded by `python -m backend.seed_demo`
DEMO_EMAIL=demo@nutriwise.app
DEMO_PASSWORD=nutriwise123

# ---- LLM for off-dataset foods, meal parsing, and the analysis summary ----
# Google Gemini. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
